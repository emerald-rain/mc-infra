[Unit]
Description=Minecraft panel agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=malysh
# AGENT_TOKEN and the R2 settings stop.sh needs
EnvironmentFile=/etc/mc.env
ExecStart=/usr/bin/python3 /home/malysh/mc-infra/server/agent/agent.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
