# Copy to .dev.vars and fill in
# Upload: npx wrangler@4 secret bulk .dev.vars

# Panel login password (any username)
PANEL_PASSWORD=

# Hetzner · console.hetzner.com → project → Security → API tokens (Read & Write)
HETZNER_TOKEN=

# R2 backups · dash.cloudflare.com → R2 → Manage API tokens (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# DNS · My Profile → API Tokens → "Edit zone DNS", zone knash.party
CF_API_TOKEN=
# knash.party → Overview → Zone ID (right column)
CF_ZONE_ID=

# Tunnel · Zero Trust → Networks → Tunnels → your tunnel → eyJ... token in install command
TUNNEL_TOKEN=
# Panel ↔ agent shared secret · openssl rand -hex 32
AGENT_TOKEN=